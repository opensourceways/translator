# ── GitCode 凭据 ─────────────────────────────────────────────
# 说明：生产（K8s + Vault Agent Injector）的凭据由 /vault/secrets/.env 文件注入，
# 应用直接读取该文件、凭据不进进程环境；本文件里的凭据仅用于本地/compose 运行
# （该文件不存在时应用回退读取环境变量）。
# 默认 token（必需）：对译稿权威仓有读权限，对未配置命名 token 的目标仓有
# Fork/PR 权限。PR 作者就是该 token 所属账号，请使用机器人账号。
GITCODE_TOKEN=please-change-me

# 来源仓覆盖（可选）：默认指向权威仓，填 fork 地址可做端到端测试，
# 留空即使用权威仓 Computing_Ecosystem_Docs/Computing_Ecosystem_Docs-EN
GITCODE_SOURCE_REPO=

# ── 命名 token（可选，按需添加）──────────────────────────────
# 键名固定为 TR_TOKEN_<名称大写>，名称=小写字母/数字/下划线（如 cann_robot）。
# 服务侧只在仓库配置保存名称引用，token 明文仅由 Vault 注入、不进进程环境。
# 新增/轮换 token = 在 Vault（生产）或此文件（本地）加一行后由运维/运维流程
# 更新；前端设置页下拉框会自动列出已配置的名称。
# 示例：
# TR_TOKEN_MINDSTUDIO=
# TR_TOKEN_CANN_ROBOT=

# ── 服务配置（TR_*）─────────────────────────────────────────
# SQLite 库与 run 工作目录根（compose 已挂 ./data:/data，勿改）
TR_DATA_DIR=/data
# webhook 鉴权 token：GitCode webhook URL 后带 ?token=<此值>
TR_WEBHOOK_TOKEN=please-change-me
# 管理端点 token（X-Admin-Token），空则管理端点放开（内部工具，默认内网部署）
TR_ADMIN_TOKEN=please-change-me
# Dashboard / 只读 API token（可选），空则只读端点放开（默认部署内网）
TR_DASH_TOKEN=
# 影子模式初始值：1=只记录不提 PR（安全默认），0=实际提 PR。
# 仅作首次启动种子，之后以库中值为准，运行时可用 POST /api/config/shadow 切换
TR_SHADOW=1
# Poller 轮询 open PR 状态的间隔秒数
TR_POLL_INTERVAL=300
# secrets 文件路径（可选）：凭据优先来源，默认 /vault/secrets/.env（生产由 Vault
# 注入）。文件不存在时凭据回退读环境变量；存在但不可读则服务启动失败
# TR_SECRETS_FILE=/vault/secrets/.env
